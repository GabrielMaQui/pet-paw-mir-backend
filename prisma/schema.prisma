generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(cuid())
  name              String
  lastName          String
  country           String?
  socketId          String?
  description       String?
  avatar            String?
  gender            String            @default("No especificado")
  address           String?
  phoneNumber       String?
  birthDate         DateTime
  account           String            @unique
  email             String            @unique
  password          String
  role              UserRole          @default(USER)
  isActive          Boolean           @default(false)
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  tokenExpiresAt    DateTime?
  verificationToken String?
  posts             Post[]
  pets              Pet[]
  comments          Comment[]
  adoptionRequests  AdoptionRequest[]
  reports           Report[]
  notifications     Notification[]
  messagesSent      Message[]         @relation("MessagesSent")
  messagesReceived  Message[]         @relation("MessagesReceived")
  followers         UserFollows[]     @relation("followers")
  following         UserFollows[]     @relation("following")
  favorites         Favorite[]
  sightings         Sighting[]
  settings          Setting?
  chats             Chat[]            @relation("ChatMembers")
}

model Pet {
  id               Int               @id @default(autoincrement())
  name             String
  petType          PetType
  breed            String?
  fur              String?
  eyeColor         String?
  gender           PetGender
  age              PetAge
  size             PetSize
  state            PetState
  description      String?
  imageUrl         String?
  validated        Boolean           @default(false)
  owner            User              @relation(fields: [ownerId], references: [id])
  ownerId          String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  posts            Post[]
  adoptionRequests AdoptionRequest[]
  sightings        Sighting?
}

model Post {
  id              Int        @id @default(autoincrement())
  user            User       @relation(fields: [userId], references: [id])
  userId          String
  pet             Pet        @relation(fields: [petId], references: [id])
  petId           Int
  title           String
  description     String     @default("")
  tags            String?
  location        String?
  state           PetState
  visibility      Visibility @default(PUBLIC)
  commentsEnabled Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  comments        Comment[]
  favorites       Favorite[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  content   String
  createdAt DateTime @default(now())
}

model AdoptionRequest {
  id        Int            @id @default(autoincrement())
  pet       Pet            @relation(fields: [petId], references: [id])
  petId     Int
  adopter   User           @relation(fields: [adopterId], references: [id])
  adopterId String
  status    AdoptionStatus @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Report {
  id           Int          @id @default(autoincrement())
  elementType  String
  elementId    Int
  reportedBy   User         @relation(fields: [reportedById], references: [id])
  reportedById String
  reason       String
  status       ReportStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Message {
  id         Int      @id @default(autoincrement())
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id])
  senderId   String
  receiver   User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  chat       Chat     @relation("ChatMessages", fields: [chatId], references: [id])
  chatId     Int
  receiverId String
  content    String
  sentAt     DateTime @default(now())
}

model UserFollows {
  follower   User     @relation("followers", fields: [followerId], references: [id])
  followerId String
  followed   User     @relation("following", fields: [followedId], references: [id])
  followedId String
  createdAt  DateTime @default(now())

  @@id([followerId, followedId])
}

model Favorite {
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  post      Post     @relation(fields: [postId], references: [id])
  postId    Int
  createdAt DateTime @default(now())

  @@id([userId, postId])
}

model Sighting {
  id        Int      @id @default(autoincrement())
  pet       Pet      @relation(fields: [petId], references: [id])
  petId     Int      @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
}

model Setting {
  id             Int               @id @default(autoincrement())
  user           User              @relation(fields: [userId], references: [id])
  userId         String            @unique
  accountPrivacy Visibility        @default(PUBLIC)
  accountBlocked Boolean           @default(false)
  blockedUsers   String?
  language       PreferredLanguage @default(ES)
  darkMode       Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model Chat {
  id        Int       @id @default(autoincrement())
  members   User[]    @relation("ChatMembers")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[] @relation("ChatMessages")
}

enum UserRole {
  USER
  ADMINISTRATOR
}

enum PreferredLanguage {
  ES
  EN
}

enum PetType {
  DOG
  CAT
  BIRD
  RABBIT
  OTHER
}

enum PetGender {
  MALE
  FEMALE
}

enum PetSize {
  SMALL
  MEDIUM
  LARGE
}

enum PetAge {
  PUPPY
  YOUNG
  ADULT
  SENIOR
}

enum PetState {
  LOST
  FOUND
  ADOPTION
  ADOPTED
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum AdoptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}
